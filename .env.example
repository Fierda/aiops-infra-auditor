# ==============================================================================
# AIOps Infra Auditor - Environment Configuration
# ==============================================================================
# Model profiles defined in auditor/config/models.yaml:
#   - local-tiny           : Qwen2.5-Coder 1.5B (CPU / 4GB RAM, fast smoke test)
#   - local-dev            : Qwen2.5-Coder 3B   (CPU / 6GB RAM, default local test)
#   - local-8gb            : Qwen2.5-Coder 7B   (8GB VRAM GPU)
#   - prod-16gb-coder      : Qwen2.5-Coder 14B Q4_K_M (<=16GB VRAM, prod default)
#   - prod-16gb-reasoning  : DeepSeek-R1 14B Q4_K_M   (<=16GB VRAM, deep taint reasoning)
#   - prod-16gb-vllm       : Qwen2.5-Coder 14B AWQ via vLLM (<=16GB VRAM, high throughput)
#   - offline-heuristic    : Deterministic rules only (0 VRAM, air-gapped CI)

AIOPS_MODEL_PROFILE=local-dev

# LLM Backend Endpoints
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=local-dev-token

# Policy Gate Settings
AIOPS_FAIL_ON_SEVERITY=HIGH
AIOPS_ENABLE_OSV_LOOKUP=false
AIOPS_MAX_LLM_FINDINGS=25

# Sample App Runtime
APP_ENV=development
APP_PORT=8080
APP_LOG_LEVEL=INFO

